  height: 44px;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 4px;
  margin-right: 15px;
  flex-shrink: 0
}

.contact .info-item h3 {
  padding: 0;
  font-size: 17px;
  font-weight: 700;
  margin-bottom: 5px
}

.contact .info-item p {
  padding: 0;
  margin-bottom: 0;
  font-size: 14px
}

.contact form input,
.contact form textarea {
  font-size: 14px;
  padding: 12px 15px;
  border-radius: 4px;
  border: 1px solid #ddd;
  width: 100%;
  margin-bottom: 12px;
  background: #fff
}

.contact form input:focus,
.contact form textarea:focus {
  outline: none;
  border-color: var(--accent-color)
}

.contact form button {
  color: #fff;
  background: var(--accent-color);
  border: 0;
  padding: 12px 34px;
  transition: .4s;
  border-radius: 4px;
  font-weight: 600;
  letter-spacing: .5px
}

.contact form button:hover {
  background: color-mix(in srgb, var(--accent-color), transparent 20%)
}

/* Page title inner */
.page-title .heading {
  padding: 150px 0 70px;
  border-top: 1px solid #eee
}

.page-title .heading h1 {
  font-size: 38px;
  font-weight: 700
}

.page-title nav {
  background: #f4f4f4;
  padding: 18px 0
}

.page-title nav ol {
  display: flex;
  list-style: none;
  margin: 0;
  font-size: 15px;
  font-weight: 600;
  flex-wrap: wrap
}

.page-title nav ol li+li::before {
  content: "/";
  display: inline-block;
  padding: 0 10px;
  color: #aaa
}

.page-title nav ol li.current {
  color: var(--accent-color)
}

/* Footer */
.footer {
  color: var(--default-color);
  background: #f9f9f9;
  font-size: 14px;
  padding: 50px 0 0
}

.footer .icon {
  color: var(--accent-color);
  margin-right: 15px;
  font-size: 24px;
  line-height: 0
}

.footer h4 {
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 15px
}

.footer .address p {
  margin-bottom: 0
}

.footer .copyright {
  padding: 25px 0;
  border-top: 1px solid #e6e6e6;
  margin-top: 30px
}

.footer .copyright p {
  margin-bottom: 0
}

/* Scroll top */
.scroll-top {
  position: fixed;
  visibility: hidden;
  opacity: 0;
  right: 15px;
  bottom: 15px;
  z-index: 99999;
  background: var(--accent-color);
  width: 40px;
  height: 40px;
  border-radius: 4px;
  transition: all .4s;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none
}

.scroll-top i {
  font-size: 24px;
  color: #fff;
  line-height: 0
}

.scroll-top:hover {
  background: color-mix(in srgb, var(--accent-color), transparent 20%);
  color: #fff
}

.scroll-top.active {
  visibility: visible;
  opacity: 1
}

/* Preloader */
#preloader {
  position: fixed;
  inset: 0;
  z-index: 999999;
  overflow: hidden;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity .6s ease-out, visibility .6s
}

#preloader.hide {
  opacity: 0;
  visibility: hidden
}

.preloader-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22px
}

.preloader-logo svg {
  width: 90px;
  height: auto;
  overflow: visible;
  animation: pl-breathe 2s ease-in-out 1.4s infinite
}

.preloader-logo polygon {
  opacity: 0;
  transform: translateY(40px);
  animation: pl-rise .7s cubic-bezier(.2, .8, .2, 1) forwards
}

.preloader-logo .pl-navy {
  fill: #293076;
  animation-delay: 0s
}

.preloader-logo .pl-orange {
  fill: #e57a2a;
  animation-delay: .25s
}

.preloader-logo .pl-peach {
  fill: #f8d5b5;
  animation-delay: .5s
}

.pl-name {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 3px;
  color: #000000;
  opacity: 0;
  animation: pl-fade .6s ease-out .9s forwards
}

.pl-name span {
  color: #000000
}

@keyframes pl-rise {
  to {
    opacity: 1;
    transform: none
  }
}

@keyframes pl-fade {
  to {
    opacity: 1
  }
}

@keyframes pl-breathe {

  0%,
  100% {
    transform: scale(1)
  }

  50% {
    transform: scale(1.06)
  }
}

@media (prefers-reduced-motion:reduce) {

  .preloader-logo svg,
  .preloader-logo polygon,
  .pl-name {
    animation: none;
    opacity: 1;
    transform: none
  }
}

/* Utilities */
.row {
  display: flex;
  flex-wrap: wrap;
  margin-right: -.75rem;
  margin-left: -.75rem
}

.row>[class*="col-"] {
  padding-right: .75rem;
  padding-left: .75rem
}

.gy-4 {
  row-gap: 1.5rem
}

.gy-5 {
  row-gap: 3rem
}

.gy-3 {
  row-gap: 1rem
}

.d-flex {
  display: flex
}

.align-items-center {
  align-items: center
}

.justify-content-between {
  justify-content: space-between
}

.justify-content-center {
  justify-content: center
}

.justify-content-around {
  justify-content: space-around
}

.flex-column {
  flex-direction: column
}

.flex-shrink-0 {
  flex-shrink: 0
}

.text-center {
  text-align: center
}

.mb-0 {
  margin-bottom: 0
}

.mb-4 {
  margin-bottom: 1.5rem
}

.mt-2 {
  margin-top: .5rem
}

.mt-3 {
  margin-top: 1rem
}

.mt-4 {
  margin-top: 1.5rem
}

.mt-5 {
  margin-top: 3rem
}

.position-relative {
  position: relative
}

.w-100 {
  width: 100%
}

.h-100 {
  height: 100%
}

.col-lg-3,
.col-lg-4,
.col-lg-5,
.col-lg-6,
.col-lg-8,
.col-md-6,
.col-xl-4 {
  position: relative;
  width: 100%
}

@media(min-width:576px) {
  .col-md-6 {
    flex: 0 0 50%;
    max-width: 50%
  }
}

@media(min-width:992px) {
  .col-lg-3 {
    flex: 0 0 25%;
    max-width: 25%
  }

  .col-lg-4 {
    flex: 0 0 33.3333%;
    max-width: 33.3333%
  }

  .col-lg-5 {
    flex: 0 0 41.6666%;
    max-width: 41.6666%
  }

  .col-lg-6 {
    flex: 0 0 50%;
    max-width: 50%
  }

  .col-lg-8 {
    flex: 0 0 66.6666%;
    max-width: 66.6666%
  }
}

@media(min-width:1200px) {
  .col-xl-4 {
    flex: 0 0 33.3333%;
    max-width: 33.3333%
  }
}

/* Team */
.team .team-member {
  background: var(--surface-color);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 5px 60px 0 rgba(0, 0, 0, .08);
  height: 100%;
  transition: transform .3s
}

.team .team-member .member-img {
  position: relative;
  overflow: hidden;
  background: #e9e9ef
}

.team .team-member .member-img img {
  width: 100%;
  aspect-ratio: 1/1;
  object-fit: cover;
  object-position: top;
  display: block;
  transition: transform .5s
}

.team .team-member .social {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -50px;
  display: flex;
  justify-content: center;
  gap: 10px;
  padding: 14px 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, .55));
  opacity: 0;
  transition: all .3s
}

.team .team-member .social a {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--accent-color);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  transition: .3s
}

.team .team-member .social a:hover {
  background: var(--heading-color);
  color: #fff
}

.team .team-member .member-info {
  text-align: center;
  padding: 22px 15px 26px;
  border-bottom: 5px solid var(--surface-color);
  transition: border-color .3s
}

.team .team-member .member-info h4 {
  font-size: 19px;
  font-weight: 700;
  margin: 0 0 4px
}

.team .team-member .member-info span {
  font-size: 14px;
  color: color-mix(in srgb, var(--default-color), transparent 30%)
}

.team .team-member:hover {
  transform: translateY(-8px)
}

.team .team-member:hover .member-img img {
  transform: scale(1.05)
}

.team .team-member:hover .social {
  bottom: 0;
  opacity: 1
}

.team .team-member:hover .member-info {
  border-color: var(--accent-color)
}

@media(hover:none) {
  .team .team-member .social {
    bottom: 0;
    opacity: 1
  }
}
