<file path="assets/css/main.css">
:root {
  --default-font: "Roboto", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --heading-font: "Raleway", sans-serif;
  --nav-font: "Poppins", sans-serif;
  --background-color: #ffffff;
  --default-color: #444444;
  --heading-color: #000000;
  --accent-color: #E57A2A;
  --surface-color: #ffffff;
  --contrast-color: #ffffff;
  --nav-color: #444444;
  --nav-hover-color: #000000;
  --nav-mobile-background-color: #ffffff;
  --nav-dropdown-background-color: #ffffff;
  --nav-dropdown-color: #444444;
  --nav-dropdown-hover-color: #E57A2A;
}

* {
  box-sizing: border-box
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px
}

body {
  color: var(--default-color);
  background: var(--background-color);
  font-family: var(--default-font);
  margin: 0
}

a {
  color: var(--accent-color);
  text-decoration: none;
  transition: 0.3s
}

a:hover {
  color: color-mix(in srgb, var(--accent-color), transparent 25%);
  text-decoration: none
}

h1,
h2,
h3,
h4,
h5,
h6 {
  color: var(--heading-color);
  font-family: var(--heading-font);
  margin-top: 0
}

img {
  max-width: 100%;
  height: auto
}

section,
.section {
  color: var(--default-color);
  background: var(--background-color);
  padding: 60px 0;
  overflow: clip
}

.light-background {
  --background-color: #f9f9f9;
  --surface-color: #ffffff;
  background: #f9f9f9
}

.dark-background {
  background: #060606;
  color: #fff;
  --heading-color: #fff;
  --default-color: #fff;
  --surface-color: #252525;
  --contrast-color: #fff
}

/* Header */
.header {
  color: var(--default-color);
  background: var(--background-color);
  padding: 15px 0;
  transition: all .5s;
  z-index: 997;
  box-shadow: 0 0 18px rgba(0, 0, 0, .1)
}

.header.scrolled {
  background: #fff
}

.header .logo {
  line-height: 1
}

.header .logo h1 {
  font-size: 26px;
  margin: 0;
  font-weight: 900;
  letter-spacing: .5px;
  color: var(--heading-color);
  font-family: var(--heading-font);
  text-transform: uppercase
}

.header .logo h1 span {
  color: var(--accent-color)
}

.header .logo .logo-text {
  line-height: 1.2
}

.header .logo .logo-tagline {
  margin: 2px 0 0;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: .3px;
  color: var(--default-color);
  opacity: .75
}

.header .logo .logo-img {
  height: 65px;
  width: auto;
  margin-right: 10px;
  display: block
}

@media (max-width:575px) {
  .header .logo .logo-img {
    height: 50px;
    margin-right: 8px
  }

  .header .logo h1 {
    font-size: 20px
  }

  .header .logo .logo-tagline {
  font-size: 10px
}
}

.container-fluid {
  width: 100%;
  padding-right: 1.5rem;
  padding-left: 1.5rem;
  margin-right: auto;
  margin-left: auto
}

.container {
  width: 100%;
  padding-right: 1rem;
  padding-left: 1rem;
  margin-right: auto;
  margin-left: auto;
  max-width: 1200px
}

/* Nav */
.navmenu ul {
  margin: 0;
  padding: 0;
  display: flex;
  list-style: none;
  align-items: center;
  gap: 4px
}

.navmenu li {
  position: relative
}

.navmenu a {
  color: var(--nav-color);
  font-size: 15px;
  padding: 8px 12px;
  font-family: var(--nav-font);
  font-weight: 600;
  position: relative;
  transition: .3s;
  display: inline-block
}

.navmenu a:before {
  content: "";
  position: absolute;
  width: 0;
  height: 2px;
  bottom: 2px;
  left: 12px;
  background: var(--accent-color);
  transition: all .3s ease-in-out
}

.navmenu a:hover:before,
.navmenu .active:before {
  width: calc(100% - 24px)
}

.navmenu a:hover,
.navmenu .active {
  color: var(--nav-hover-color)
}

.mobile-nav-toggle {
  display: none;
  font-size: 28px;
  cursor: pointer;
  color: var(--nav-color)
}

@media(max-width:991px) {
  .navmenu ul {
    display: none;
    position: absolute;
    top: 70px;
    left: 20px;
    right: 20px;
    flex-direction: column;
    align-items: stretch;
    background: #fff;
    padding: 10px 0;
    border-radius: 6px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, .1);
    max-height: 80vh;
    overflow-y: auto
  }

  .navmenu a {
    padding: 12px 20px
  }

  .navmenu a:before {
    display: none
  }

  .mobile-nav-toggle {
    display: block
  }

  .mobile-nav-active .navmenu ul {
    display: flex
  }

  .mobile-nav-active {
    overflow: hidden
  }
}

/* Hero */
.hero {
  padding: 0;
  position: relative
}

.hero .carousel {
  width: 100%;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background: #111
}

.hero img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1
}

.hero .carousel-item {
  position: absolute;
  inset: 0;
  overflow: hidden;
  transition: opacity .8s
}

.hero .carousel-item:before {
  content: "";
  background: rgba(0, 0, 0, .45);
  position: absolute;
  inset: 0;
  z-index: 2
}

.hero .carousel-container {
  position: absolute;
  inset: 90px 100px;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  z-index: 3;
  text-align: center;
  color: #fff
}

.hero p {
  color: #fff;
  font-family: var(--heading-font);
  letter-spacing: 3px;
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 15px
}

.hero h2 {
  margin-bottom: 30px;
  font-size: 56px;
  font-weight: 900;
  text-transform: uppercase;
  color: #fff;
  line-height: 1.05
}

.hero .btn-get-started {
  color: #fff;
  font-family: var(--heading-font);
  font-weight: 600;
  font-size: 14px;
  letter-spacing: 1px;
  text-transform: uppercase;
  display: inline-block;
  padding: 12px 32px;
  border-radius: 50px;
  transition: .5s;
  margin: 8px;
  border: 2px solid var(--accent-color);
  background: transparent
}

.hero .btn-get-started:hover {
  background: var(--accent-color);
  color: #fff
}

@media(max-width:768px) {
  .hero h2 {
    font-size: 34px
  }

  .hero .carousel-container {
    inset: 90px 30px
  }

  .hero p {
    font-size: 12px
  }
}

/* Section title */
.section-title {
  text-align: center;
  padding-bottom: 50px
}

.section-title h2 {
  font-size: 32px;
  font-weight: 700;
  margin-bottom: 15px
}

.section-title p {
  margin-bottom: 0;
  color: color-mix(in srgb, var(--default-color), transparent 20%)
}


/* ==========================================================
   About · Business areas · Mission & Vision · Principles
   ========================================================== */
:root {
  --brand-navy: #293076;
  --brand-peach: #f8d5b5;
  --rule: #cfcfcf;
}

section.about,
section.direction,
section.principles {
